# Build artifacts
dist/
build/
*.tsbuildinfo

# Dependencies
node_modules/
.pnpm-store/

# Local npm cache, used because the global cache is not writable in this
# environment (root-owned files). Keeps installs reproducible without sudo.
.npm-cache/

# Generated browser bundles. Rebuilt by `pnpm build:web` from the TypeScript
# sources, so they are output rather than source.
public/engine/
public/viewer/
.build-stage/

# Training output — these get large and are reproducible from checkpoint + seed
runs/
*.jsonl
!docs/**/*.jsonl

# Screenshots and recordings produced during verification
captures/

# OS noise
.DS_Store
._*
.Spotlight-V100
.Trashes

# Trained drivers: produced by `train`, published by the build, not source.
checkpoints/
public/checkpoints/

# Training logs and the running trainer's pid file.
logs/*.log
logs/*.pid
