{
  "name": "ai-f1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evolutionary F1 racing AI: deterministic 2D sim, ES trainer, live viewer",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test 'packages/**/test/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint:determinism && pnpm test",
    "build:web": "node scripts/build-browser.ts",
    "drive": "node scripts/build-browser.ts && node packages/cli/src/serve.ts",
    "train": "node packages/cli/src/train.ts",
    "bench": "node packages/engine/test/bench.ts",
    "lint:determinism": "node scripts/lint-determinism.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
